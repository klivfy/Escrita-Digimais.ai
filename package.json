{
  "name": "assistente-textos-service-desk",
  "version": "1.0.0",
  "private": true,
  "description": "Extensão empresarial para Microsoft Edge que auxilia analistas de Service Desk na redação de textos de chamados. Funciona localmente, sem rede.",
  "license": "Unlicense",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build:dev": "vite build --mode development && node scripts/postbuild.mjs dist-dev && node scripts/verify-dist.mjs dist-dev",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "package": "npm run build && node scripts/verify-dist.mjs && node scripts/package.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:dist && npm run build:dev",
    "audit:deps": "npm audit --omit=dev"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource-variable/google-sans-flex": "5.3.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
